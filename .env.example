# ---- Merge Gateway (AI API router) — primary LLM path ----
# Get a key at https://merge.dev. If set, the app routes through Merge Gateway
# to the model selected in merge.gateway.model (or per-request from the frontend).
MERGE_GATEWAY_API_KEY=

# Default model when none is selected in the frontend dropdown.
# Options: google/gemini-3-flash-preview, minimax/minimax-m2.7, zai/glm-5.3-flash,
#          anthropic/claude-sonnet-4-6, and 170+ more on Merge Gateway.
MERGE_GATEWAY_MODEL=google/gemini-3-flash-preview

# ---- Anthropic Claude API (secondary path, optional) ----
# Used only if MERGE_GATEWAY_API_KEY is not set. Read from env only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
